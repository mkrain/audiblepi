{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "strict": true,
    // "node" is needed for Jest tests (fs/path/__dirname); app runtime code
    // must not rely on node APIs (Metro/Hermes have none).
    "types": ["jest", "node"]
  }
}
